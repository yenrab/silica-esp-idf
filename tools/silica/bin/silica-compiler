#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
#
# SPDX-License-Identifier: Apache-2.0
"""
Placeholder for the Silica compiler.

This is NOT the Silica compiler. It is a stand-in that mimics the real
compiler's file-level contract closely enough that the ESP-IDF build-system
plumbing for Silica can be developed and tested before the real compiler is
ready. See SILICA_INTEGRATION_PLAN.md at the repository root.

Contract mimicked (matches the real self-hosted compiler as of Sept 2026):

* No argv is required. The compiler reads ``silica.config`` from the current
  working directory: one ``.silica`` path per line, leaf-to-root order,
  ``main.silica`` last.
* For every listed unit ``dir/name.silica`` it writes ``dir/name.sams``
  (assembly text) and ``dir/name.iface`` (interface cache) next to the source.
* It may exit with code 75 (EX_TEMPFAIL) between units and expect to be
  re-invoked until it exits 0. This placeholder never does so unless
  ``SILICA_PLACEHOLDER_EXIT75=1`` is set, which forces one exit-75 round so the
  re-invoke loop in the build wrapper can be tested.

Extensions the real compiler does NOT have yet (tracked as requirements in the
plan): ``--version`` and ``--help``. They are implemented here so that
``tools.json`` version checking can be exercised.
"""
import os
import sys

PLACEHOLDER_VERSION = '0.0.0-placeholder'
CONFIG_NAME = 'silica.config'
ORDER_NAME = 'silica.compile.order'
MISSING_CONFIG_MSG = (
    'Error: silica.config not found or empty. Create silica.config with one .silica file per line.'
)


def print_version() -> None:
    print(f'silica-compiler {PLACEHOLDER_VERSION}')


def print_help() -> None:
    print(
        'silica-compiler (PLACEHOLDER, not the real compiler)\n'
        '\n'
        'Usage: silica-compiler            compile units listed in ./silica.config\n'
        '       silica-compiler --version  print the version string\n'
        '       silica-compiler --help     print this text\n'
    )


def read_config(path: str) -> list:
    if not os.path.isfile(path):
        return []
    with open(path, encoding='utf-8') as f:
        units = [line.strip() for line in f if line.strip() and not line.lstrip().startswith('#')]
    return units


def emit_unit(unit: str) -> None:
    if not unit.endswith('.silica'):
        sys.exit(f'Error: {unit}: not a .silica unit')
    if not os.path.isfile(unit):
        sys.exit(f'Error: {unit}: file not found')
    stem = unit[: -len('.silica')]
    module = os.path.basename(stem)
    target = os.environ.get('SILICA_TARGET', 'unspecified')

    with open(stem + '.sams', 'w', encoding='utf-8') as f:
        f.write(
            '/* Generated by the PLACEHOLDER silica-compiler; contains no code. */\n'
            f'/* module: {module} */\n'
            f'/* source: {unit} */\n'
            f'/* target: {target} */\n'
            '\t.text\n'
        )
    with open(stem + '.iface', 'w', encoding='utf-8') as f:
        f.write(
            'SILICA_IFACE_V1\n'
            f'module={module}\n'
            'stamp=placeholder-iface-0\n'
            'format=2\n'
            f'source={unit}\n'
            'source_hash=0\n'
            'deps=\n'
            'deps_hash=0\n'
            'export_trait=\n'
            'export_count=0\n'
            'impl_count=0\n'
            '===DAG===\n'
        )


def main() -> int:
    args = sys.argv[1:]
    if args == ['--version']:
        print_version()
        return 0
    if args in (['--help'], ['-h']):
        print_help()
        return 0
    if args:
        sys.stderr.write(f'silica-compiler (placeholder): unknown arguments {args!r}\n')
        return 2

    units = read_config(CONFIG_NAME)
    if not units:
        sys.stderr.write(MISSING_CONFIG_MSG + '\n')
        return 1

    # Resume protocol: if a compile order file exists we are being re-invoked.
    resumed = os.path.isfile(ORDER_NAME)
    if resumed:
        units = read_config(ORDER_NAME)
        print(f'Resuming compile order; units left: {len(units)}')

    force_exit75 = os.environ.get('SILICA_PLACEHOLDER_EXIT75') == '1' and not resumed
    for index, unit in enumerate(units):
        emit_unit(unit)
        print(f'[placeholder] compiled {unit}')
        if force_exit75 and index == 0 and len(units) > 1:
            with open(ORDER_NAME, 'w', encoding='utf-8') as f:
                f.write('\n'.join(units[index + 1:]) + '\n')
            return 75

    if resumed:
        os.remove(ORDER_NAME)
    return 0


if __name__ == '__main__':
    sys.exit(main())
